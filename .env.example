# Privy application ID — create one at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: custom Base mainnet RPC URL (falls back to the public Base RPC)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Canonical public URL of the deployed site (used for OG/Twitter metadata).
# Set this to your Vercel site URL after the first deploy, e.g.
# https://your-app.vercel.app  (falls back to localhost in dev)
NEXT_PUBLIC_SITE_URL=
