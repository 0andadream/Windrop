{
  "name": "windrop-extension",
  "displayName": "WinDrop — Gift Lottery Luck",
  "version": "0.1.0",
  "description": "Gift Megapot lottery tickets to anyone on X — one tap from their profile.",
  "author": "WinDrop",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4"
  },
  "manifest": {
    "name": "WinDrop — Gift Lottery Luck",
    "permissions": ["activeTab"],
    "host_permissions": ["https://x.com/*", "https://twitter.com/*"]
  }
}
